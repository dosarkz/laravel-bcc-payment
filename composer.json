{
    "name": "dosarkz/laravel-bcc-payment",
    "description": "Bank CenterCredit (BCC) e-commerce payment link generator for Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "bcc",
        "bank-centercredit",
        "payment",
        "kazakhstan"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dosarkz\\BccPayment\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dosarkz\\BccPayment\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dosarkz\\BccPayment\\BccPaymentServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
